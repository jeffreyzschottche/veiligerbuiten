# Website: private backend origin, never exposed in browser config
NUXT_API_ORIGIN=http://127.0.0.1:8000
# Same strong random secret as VB_SITE_STATS_TOKEN on the backend
NUXT_SITE_STATS_TOKEN=
# Static mobile builds only (npm run build:mobile)
NUXT_PUBLIC_API_BASE_URL=https://api.veiligerbuiten.nl/api/v1
# RevenueCat: publieke SDK-sleutels (Project → API keys), nodig voor kopen in de app
NUXT_PUBLIC_REVENUECAT_IOS_KEY=
NUXT_PUBLIC_REVENUECAT_ANDROID_KEY=
# Winkellinks (leeg = knoppen springen naar de prijs-sectie)
NUXT_PUBLIC_APP_STORE_URL=
NUXT_PUBLIC_PLAY_STORE_URL=
# AdMob: banner-units uit de AdMob-console; standaard die van VeiligerBuiten. Leeg = geen advertenties.
# De app-ID's staan native: android/app/src/main/res/values/strings.xml en ios/App/App/Info.plist.
NUXT_PUBLIC_ADMOB_BANNER_IOS=
NUXT_PUBLIC_ADMOB_BANNER_ANDROID=
NUXT_PUBLIC_ADMOB_TESTING=false
