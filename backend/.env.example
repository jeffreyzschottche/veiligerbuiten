APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
KNMI_API_KEY=
NDW_OPEN_DATA_URL=https://opendata.ndw.nu/veiligheidsgerelateerde_berichten_srti.xml.gz
LUCHTMEETNET_ENABLED=false
LUCHTMEETNET_URL=https://api.luchtmeetnet.nl/open_api
LUCHTMEETNET_STATIONS=[]
LUCHTMEETNET_REQUEST_SPACING_MS=3100
LUCHTMEETNET_MAX_MEASUREMENT_AGE_MINUTES=90
# Add only after validating the current RWS WaterWebservices/WADAR contract.
RWS_WATER_OBSERVATIONS_URL=
POLITIE_NEWS_ENABLED=true
POLITIE_NEWS_URL=https://api.politie.nl/v4/nieuws
POLITIE_NEWS_NATIONWIDE=true
POLITIE_NEWS_AREAS=[{"lat":52.3000,"lng":4.6900}]
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_JSON_BASE64=
PUSH_DELIVERY_DRIVER=log

# Account, abonnement en AI (zie docs/currentmission.md)
VB_BILLING_BYPASS=false
VB_REPORTS_PER_DAY=3
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_ENTITLEMENT=premium
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=nl.veiligerbuiten.app
APNS_PRODUCTION=false

# Publieke bronnen (standaardwaarden werken)
NL_ALERT_URL=https://api.public-warning.app/api/v1/providers/nl-alert/alerts
KNMI_QUAKES_URL=https://rdsa.knmi.nl/fdsnws/event/1/query

# Server-only website aggregate: match NUXT_SITE_STATS_TOKEN on the Nuxt server
VB_SITE_STATS_TOKEN=

# Zschot CMS: token voor /api/v1/ops/status (status, betalingen, fouten). Leeg = uit.
OPS_TOKEN=
